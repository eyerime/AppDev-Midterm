@page "/cart"
@inject CartService Basket

<PageTitle>Your cart · Resound</PageTitle>

<div class="container cart">
    <h1 class="display title">Your <span class="text-volt-bg">Cart</span></h1>

    @if (Basket.Count == 0)
    {
        <div class="empty">
            <p class="display empty-title">Your cart is empty</p>
            <a href="/#market" class="btn btn-volt">Shop gear <Icon Name="IconName.Arrow" /></a>
        </div>
    }
    else
    {
        <div class="layout">
            <ul class="lines">
                @foreach (var item in Basket.Items)
                {
                    <li class="line">
                        <a href="items/@item.Id"><img src="@item.Img" alt="@item.Name" /></a>
                        <div>
                            <p class="muted small">@item.Brand · @item.Category.DisplayName()</p>
                            <h3><a href="items/@item.Id">@item.Name</a></h3>
                            <p class="muted small">@item.Condition</p>
                            <button class="remove" @onclick="() => Basket.Remove(item.Id)">Remove</button>
                        </div>
                        <p class="price">@Format.Money(item.Price)</p>
                    </li>
                }
            </ul>

            <aside class="summary">
                <h2 class="display">Order summary</h2>
                <div class="row"><span>Subtotal</span><span>@Format.Money(Basket.Subtotal)</span></div>
                <div class="row"><span>Shipping</span><span>@Format.Money(Basket.Shipping)</span></div>
                <div class="row total"><span>Total</span><span>@Format.Money(Basket.Total)</span></div>
                <a href="checkout" class="btn btn-volt block">Checkout <Icon Name="IconName.Arrow" /></a>
                <a href="/#market" class="continue">Continue shopping</a>
            </aside>
        </div>
    }
</div>
